# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oowhois-bin
_pkgname=oowhois
pkgver=0.1.0
pkgrel=1
pkgdesc="Queries WHOIS and RDAP records for domain ownership, registrars, and CIDRs."
arch=('x86_64')
url="https://github.com/openOODA-tools/oowhois"
license=('Apache-2.0')
depends=('glibc')
provides=('oowhois')
conflicts=('oowhois')
source_x86_64=("${url}/releases/download/v${pkgver}/oowhois-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oowhois-linux-x86_64" "${pkgdir}/usr/bin/oowhois"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oowhois-uninstall"
}
